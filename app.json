{
  "expo": {
    "name": "My Birthday Tracker",
    "slug": "birthday-reminder",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-mbt2.png",
    "scheme": "birthdayreminder",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-mbt2.png",
      "resizeMode": "cover",
      "backgroundColor": "#0f172a"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mybirthdaytracker",
      "jsEngine": "hermes",
      "splash": {
        "image": "./assets/images/splash-mbt2.png",
        "resizeMode": "cover",
        "backgroundColor": "#0f172a"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-mbt2.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.pieter2frank.birthdayreminder",
      "versionCode": 120,
      "jsEngine": "hermes",
      "splash": {
        "image": "./assets/images/splash-mbt2.png",
        "resizeMode": "cover",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-32x32.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-router",
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5671d07d-15c4-4db5-85ba-cc78a50ff60b"
      }
    },
    "owner": "fascination"
  }
}
